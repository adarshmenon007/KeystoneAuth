@page "/register"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Net
@using Keystone.Contracts.Identity
@inject AuthApiClient AuthApi
@inject KeystoneAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>Register · KeystoneAuth</PageTitle>

<h1>Create your account</h1>

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label" for="displayName">Your name</label>
        <InputText id="displayName" class="form-control" @bind-Value="_model.DisplayName" autocomplete="name" />
        <ValidationMessage For="() => _model.DisplayName" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <InputText id="email" class="form-control" @bind-Value="_model.Email" autocomplete="username" />
        <ValidationMessage For="() => _model.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" autocomplete="new-password" />
        <ValidationMessage For="() => _model.Password" />
        <div class="form-text">At least 8 characters.</div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="confirmPassword">Confirm password</label>
        <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" />
        <ValidationMessage For="() => _model.ConfirmPassword" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@_busy">
        @(_busy ? "Creating account…" : "Register")
    </button>
</EditForm>

@if (_error is not null)
{
    <p class="text-danger mt-3">@_error</p>
}

<p class="mt-3">Already have an account? <a href="login">Log in</a></p>

@code {
    private readonly RegisterModel _model = new();
    private bool _busy;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var auth = await AuthApi.RegisterAsync(
                new RegisterRequest(_model.Email, _model.Password, _model.DisplayName));
            await AuthState.SignInAsync(auth);
            Navigation.NavigateTo("");
        }
        catch (KeystoneApiException ex)
        {
            _error = ex.StatusCode == HttpStatusCode.Conflict
                ? "An account with this email already exists."
                : ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class RegisterModel
    {
        [Required]
        public string DisplayName { get; set; } = string.Empty;

        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required, MinLength(8, ErrorMessage = "Password must be at least 8 characters.")]
        public string Password { get; set; } = string.Empty;

        [Required, Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
