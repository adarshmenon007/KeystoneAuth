{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "KeystoneDb": "Data Source=keystone.db"
  },
  "Jwt": {
    "Issuer": "Keystone.Api",
    "Audience": "Keystone.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:7601", "http://localhost:5601"]
  }
}
